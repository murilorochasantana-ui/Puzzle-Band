# Copie para .env (copy .env.example .env) e preencha usuário e senha.
# NUNCA commite o .env: ele está no simulator/.gitignore.

# Broker EMQX Cloud (MQTT sobre TLS, porta 8883)
MQTT_URL=mqtts://g12cbd17.ala.us-east-1.emqxsl.com:8883

# Usuário/senha da PULSEIRA no EMQX (não o usuário "dashboard" do frontend)
MQTT_USER=
MQTT_PASS=

# Mesmo valor de VITE_CHILD_ID no frontend/.env
CHILD_ID=C01
