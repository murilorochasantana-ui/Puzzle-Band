{
  "name": "puzzleband-simulator",
  "private": true,
  "version": "1.0.0",
  "description": "Pulseira Puzzle Band simulada (ESP32): gera as leituras, roda o modelo, os episódios e o gatilho (processamento na borda) e publica no broker MQTT",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "calmo": "node index.js --cenario calmo",
    "exercicio": "node index.js --cenario exercicio",
    "estereotipia": "node index.js --cenario estereotipia",
    "crise-ruido": "node index.js --cenario crise_ruido",
    "crise-luz": "node index.js --cenario crise_luz",
    "crise-sem-gatilho": "node index.js --cenario crise_sem_gatilho",
    "crise-ruido-e-luz": "node index.js --cenario crise_ruido_e_luz",
    "barulho-sem-crise": "node index.js --cenario barulho_sem_crise",
    "ruido-depois-da-crise": "node index.js --cenario ruido_depois_da_crise",
    "crise-e-recuperacao": "node index.js --cenario crise_e_recuperacao",
    "crise-com-agitacao": "node index.js --cenario crise_com_agitacao",
    "exercicio-e-crise": "node index.js --cenario exercicio_e_crise",
    "demo": "node index.js --cenario demo",
    "eventos-aleatorios": "node index.js --cenario eventos_aleatorios",
    "controle": "node index.js --cenario controle",
    "verificar": "node verificar.js",
    "verificar-app": "node ../tools/verificar-app.mjs",
    "resetar": "node resetar.js",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "mqtt": "^5.16.1"
  },
  "engines": {
    "node": ">=20.10"
  }
}
